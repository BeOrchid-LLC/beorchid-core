# ── Local development only ──────────────────────────────────────────────
# Staging and production secrets live in Infisical (Section 12) and are
# injected at deploy time by Coolify. Nothing in this file is ever a real
# credential, and .env itself is gitignored.
#
# The connection strings omit a username on purpose: PostgreSQL then defaults
# to your OS user, so this file works unchanged on any machine where that user
# is a superuser.

# ── Development database ────────────────────────────────────────────────
# Migration role — holds DDL rights incl. REFERENCES on core (Section 5.4/9.3)
DATABASE_URL_MIGRATE=postgres://localhost:5432/beorchid_core_dev

# Core API runtime role — serves requests. Holds NO privilege at all on
# core.permissions or core.role_permissions, and resolves only through the two
# filtered views, which run security_invoker = false (Section 5.2). It does not
# own core; the migration role does.
DATABASE_URL=postgres://core_api_rw:local_dev_only@localhost:5432/beorchid_core_dev

# Administration role — direct access to roles and permissions, which the
# runtime role deliberately lacks (Section 5.2).
DATABASE_URL_ADMIN=postgres://core_api_admin:local_dev_only@localhost:5432/beorchid_core_dev

REDIS_URL=redis://localhost:6379
PORT=3000

# API keys for calling apps, as <appKey>:<secret> pairs. Every Core API call is
# attributable to one app, which is what makes the access log meaningful.
APP_API_KEYS=core_web:<secret>

# ── Test database ───────────────────────────────────────────────────────
# Separate from development on purpose. The suite truncates core between
# tests, which would otherwise destroy the fixture the reference apps run on.
TEST_DATABASE_NAME=beorchid_core_test
TEST_DATABASE_URL_MIGRATE=postgres://localhost:5432/beorchid_core_test

# ── Clerk ───────────────────────────────────────────────────────────────
# Used by the SDK's TokenVerifier for local, networkless signature checking
# (Section 4.5). The JWKS URL and issuer are public endpoints, not secrets.
# Values below are the development instance.
CLERK_JWKS_URL=https://tough-deer-31.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://tough-deer-31.clerk.accounts.dev

# Secrets. Real values live in Infisical, never here (Section 12).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...   # Section 4.6, safeguard 1

NODE_ENV=development
